{
  "name": "epoch-seal",
  "version": "0.2.1",
  "description": "Seal an epoch key to a circle as Nostr events: threshold shares NIP-59 gift-wrapped to friends, a time-locked recovery request any of them can refuse by anonymous ballot, and reconstruction only when nobody did.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENCE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nostr",
    "shamir",
    "threshold",
    "recovery",
    "coercion",
    "epoch",
    "nip-59",
    "ring-signature",
    "gift-wrap",
    "secret-sharing",
    "key-recovery",
    "time-lock",
    "typescript"
  ],
  "author": "ForgeSworn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/epoch-seal"
  },
  "homepage": "https://github.com/forgesworn/epoch-seal#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/epoch-seal/issues"
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@forgesworn/ring-sig": "^3.0.3",
    "@noble/hashes": "^2.0.1",
    "dominion-protocol": "^1.1.1",
    "nostr-anon-vote": "^0.2.2",
    "nostr-tools": "2.23.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nostr-tools": "2.23.9"
  }
}
